# Vercel environment variables
# Replace placeholder values in the Vercel dashboard. Never commit real secrets.

NODE_ENV=production
CORS_ORIGIN=https://a2z-learning-solutions.vercel.app

# AI providers
OPENAI_API_KEY=default_openai_key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=default_gemini_key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# Razorpay
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_default_key
RAZORPAY_KEY_SECRET=default_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=default_webhook_secret

# Optional email receipts
SMTP_HOST=default_smtp_host
SMTP_PORT=587
SMTP_USER=default_email@example.com
SMTP_PASS=default_email_password
SMTP_FROM=default_email@example.com
