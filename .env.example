PORT=3000

# ============================================================================
# OPENAI API CONFIGURATION (Required for AI Instant Doubt Solver)
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
# Free tier: $5 credit, then ~$0.50 per 1M tokens (GPT-3.5-turbo)
OPENAI_API_KEY=sk_

# ============================================================================
# OPTIONAL: Google Gemini API (Legacy Support)
# ============================================================================
GEMINI_API_KEY=your_google_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# ============================================================================
# RAZORPAY PAYMENT GATEWAY (For Subscriptions)
# ============================================================================
# Get your keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================================================
# EMAIL CONFIGURATION (For Notifications)
# ============================================================================
# Optional SMTP settings for automatic payment receipts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@example.com
